# Copy to .env.important and .env.all-function — the two suites run on two different environments.
# The files are git-ignored and must never be committed. Accounts do not go here: they live in
# src/data/<suite>/users.json (see users.example.json).

# Base URL of the tenant, including the tenant path and a trailing slash:
#   https://<host>/<tenant>/
BASE_URL=

# WARNING: the app locks an account after a few failed passwords and the lock can last hours.
# Double-check the account in users.json before the first run.

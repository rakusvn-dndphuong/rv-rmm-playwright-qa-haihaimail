# Dependencies
node_modules/

# Credentials — never commit (one file per suite)
.env
.env.*
!.env.example

# Per-suite data holding real accounts and environment-specific records
src/data/*/users.json
src/data/*/preconditions.json

# Session state produced by the auth setup projects
playwright/.auth/

# Test run artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs and scratch files
*.log
.DS_Store
Thumbs.db

{
  "name": "rv-rmm-playwright-qa-haihaimail",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end test framework for RMM (配配メール) — Playwright + TypeScript. Two suites: Important test and All Function test.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:important": "playwright test --project=important",
    "test:all-function": "playwright test --project=all-function",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "codegen": "playwright codegen --ignore-https-errors",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
